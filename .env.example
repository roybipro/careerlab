# Copy to .env at the repo root and adjust. Never commit real values.
# The root .env is read by Docker Compose and by the backend when run from backend/
# (or anywhere inside the checkout). Variables already set in the environment win.

# Local Postgres (docker-compose.yml). These are local development defaults only.
POSTGRES_USER=careerlab
POSTGRES_PASSWORD=careerlab

# Backend (required, no defaults). This URL is for running the backend on your host;
# the api container in Compose builds its own URL pointing at the db service.
DATABASE_URL=postgresql+psycopg://careerlab:careerlab@localhost:5433/careerlab
# Required, at least 32 characters. Left empty on purpose: the backend refuses to start
# until you set one, and Compose falls back to a development-only value while it is empty.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# true in production (HTTPS), false for local http
COOKIE_SECURE=false
# Only origin allowed by CORS in local development
FRONTEND_ORIGIN=http://localhost:3000
# true when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# Frontend (frontend/, Next.js). Base URL of the backend API that /api/v1/* is proxied to.
# Defaults to http://localhost:8000 in development. The rewrite is fixed at `next build`,
# not at runtime, so set this in the build environment (for example on Vercel) before building.
# A production build warns when it is unset, and fails when VERCEL is set (it always is on Vercel).
API_URL=http://localhost:8000

# Per-IP limit on registrations per minute. Keep the default of 5 in production.
# Only the end-to-end test environment raises it (Playwright registers several users from one IP).
# RATE_LIMIT_REGISTER_PER_MINUTE=5

# Registrations per minute across all IPs (default 30), a backstop if forwarded IPs are spoofed.
# Keep the default in production. Only the end-to-end test environment raises it: one Playwright
# run registers about 25 users, so back-to-back runs would share the window.
# RATE_LIMIT_REGISTER_GLOBAL_PER_MINUTE=30

# Most Argon2 password hashes allowed to run at once (default 4). Each uses about 64 MiB,
# so 4 is roughly 260 MiB at peak. Lower it on a small host: render.yaml sets 2 for
# Render's free instance. A request that cannot get a slot within 2 seconds gets a 429.
# MAX_CONCURRENT_HASHES=4

# Demo data (optional). backend/scripts/seed_demo.py reads DEMO_PASSWORD from the process
# environment, not from this file. Pass it on the command line and never commit it:
#   docker compose exec -e DEMO_PASSWORD='choose-a-password' api python scripts/seed_demo.py
